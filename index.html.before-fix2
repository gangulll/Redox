<!DOCTYPE html>
<html lang="en" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Redox Funded Squad | Next-Gen Prop Trading Firm</title>
<meta name="description" content="Trade up to $200,000 with up to 90% profit split. $5K evaluation challenge for just $5.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://unpkg.com/lucide@latest"></script>
<script>
tailwind.config = {
  darkMode: 'class',
  theme: {
    extend: {
      fontFamily: {
        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
        mono: ['"JetBrains Mono"', 'monospace'],
      },
      colors: {
        brand: {
          50: '#ecfdf5', 400: '#34d399', 500: '#10b981', 600: '#059669',
          accent: '#6366f1', gold: '#f59e0b', dark: '#0a0d14',
          card: '#111726', border: '#1f293d',
        }
      }
    }
  }
}
</script>
<style>
body { background-color: #080b11; color: #e2e8f0; overflow-x: hidden; }
.gradient-glow { background: radial-gradient(circle at 50% 20%, rgba(16,185,129,0.15) 0%, rgba(99,102,241,0.08) 45%, transparent 70%); }
.card-glass { background: rgba(17,23,38,0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.07); }
.card-glow:hover { border-color: rgba(16,185,129,0.4); box-shadow: 0 0 25px rgba(16,185,129,0.15); }
.custom-scrollbar::-webkit-scrollbar { width: 6px; }
.custom-scrollbar::-webkit-scrollbar-track { background: #111726; }
.custom-scrollbar::-webkit-scrollbar-thumb { background: #1f293d; border-radius: 3px; }
</style>
</head>
<body class="font-sans antialiased">

<!-- PROMO BANNER -->
<div class="bg-gradient-to-r from-emerald-900/40 via-emerald-800/30 to-emerald-900/40 border-b border-emerald-500/20">
  <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-center gap-3 text-xs sm:text-sm">
    <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono font-bold">FLASH PROMO</span>
    <span class="text-gray-300 hidden sm:inline">Start your prop career: <strong class="text-white">$5,000 Account Challenge for only $5!</strong> Instant cTrader credentials.</span>
    <span class="text-gray-300 sm:hidden"><strong class="text-white">$5K for $5!</strong></span>
    <a href="#challenges" class="text-emerald-400 font-semibold hover:text-emerald-300 underline">Claim Now &rarr;</a>
  </div>
</div>

<!-- HEADER -->
<header class="border-b border-white/5 bg-[#080b11]/80 backdrop-blur-xl sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center">
        <i data-lucide="trending-up" class="w-6 h-6 text-black"></i>
      </div>
      <div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-lg sm:text-xl font-extrabold text-white tracking-tight">REDOX</span>
          <span class="text-emerald-400 font-bold text-sm sm:text-base">FUNDED SQUAD</span>
        </div>
        <div class="text-[10px] text-gray-500 font-mono uppercase tracking-widest">Institutional Prop Firm</div>
      </div>
    </div>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-400">
      <a href="#challenges" class="hover:text-emerald-400 transition">Challenges</a>
      <a href="#models" class="hover:text-emerald-400 transition">Models</a>
      <a href="#rules" class="hover:text-emerald-400 transition">Rules</a>
      <a href="#platforms" class="hover:text-emerald-400 transition">Platforms</a>
      <a href="#payouts" class="hover:text-emerald-400 transition">Payouts</a>
      <a href="#faq" class="hover:text-emerald-400 transition">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      <button id="header-dashboard-btn" onclick="openDashboard()" class="hidden text-sm font-semibold text-gray-300 hover:text-white px-4 py-2 rounded-lg transition">
        Dashboard
      </button>
      <button id="header-logout-btn" onclick="handleLogout()" class="hidden text-sm font-semibold text-red-400 hover:text-red-300 px-4 py-2 rounded-lg transition">
        Logout
      </button>
      <button id="header-login-btn" onclick="openModal('login-modal')" class="hidden sm:inline-flex text-sm font-semibold text-gray-300 hover:text-white px-4 py-2 rounded-lg transition">
        Trader Login
      </button>
      <a href="#" onclick="event.preventDefault(); openSignup()" class="bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-black font-bold text-sm px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-500/25 transition transform hover:-translate-y-0.5">
        Get Funded
      </a>
    </div>
  </div>
</header>

<main>
  <!-- HERO -->
  <section class="relative gradient-glow pt-16 pb-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full card-glass text-xs font-medium text-gray-300 mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Up to 90% Profit Split &bull; Bi-Weekly Fast Crypto Payouts</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight mb-6">
        Trade Institutional Capital.<br>
        <span class="bg-gradient-to-r from-emerald-400 to-emerald-600 bg-clip-text text-transparent">Keep 90% of the Profits.</span>
      </h1>

      <p class="text-base sm:text-lg text-gray-400 max-w-3xl mx-auto mb-10 leading-relaxed">
        Prove your edge with our transparent evaluation challenges. 12% &amp; 8% profit targets, 3 minimum trading days, zero hidden rules, and instant account provisioning on cTrader.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
        <a href="#challenges" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-base transition flex items-center justify-center gap-2">
          <i data-lucide="zap" class="w-5 h-5"></i> Explore Challenges
        </a>
        <button onclick="openModal('dashboard-preview-modal')" class="w-full sm:w-auto px-8 py-4 rounded-xl card-glass hover:bg-white/10 text-white font-semibold text-base transition flex items-center justify-center gap-2">
          <i data-lucide="layout-dashboard" class="w-5 h-5"></i> Interactive Trader Portal
        </button>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
        <div class="card-glass p-5 rounded-2xl border border-white/5">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">$5,000,000+</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wider">Funded Capital</div>
        </div>
        <div class="card-glass p-5 rounded-2xl border border-white/5">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">90%</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wider">Trader Profit Split</div>
        </div>
        <div class="card-glass p-5 rounded-2xl border border-white/5">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">&lt; 8 Hours</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wider">Payout Processing</div>
        </div>
        <div class="card-glass p-5 rounded-2xl border border-white/5">
          <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">3 Days</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wider">Min. Trading Days</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHALLENGES -->
