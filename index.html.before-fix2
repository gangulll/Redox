            <div class="flex justify-between"><span class="text-gray-400">Phase 1 Target</span><span class="font-bold text-white">12% ($3,000)</span></div>
            <div class="flex justify-between"><span class="text-gray-400">Phase 2 Target</span><span class="font-bold text-white">8% ($2,000)</span></div>
