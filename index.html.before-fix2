        <button id="btn-one-phase" onclick="switchModel('one-phase')" class="px-5 py-2.5 rounded-xl font-medium text-sm text-gray-300 hover:text-white transition">1-Phase Express (10%)</button>
        <button id="btn-instant" onclick="switchModel('instant')" class="px-5 py-2.5 rounded-xl font-medium text-sm text-gray-300 hover:text-white transition flex items-center gap-1.5">Instant Funded <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-500/20 text-indigo-300 font-mono">No Eval</span></button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="plans-grid">
        <!-- $5K -->
        <div class="card-glass rounded-3xl border-2 border-emerald-500/60 p-6 relative card-glow transition">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-emerald-500 text-black text-xs font-extrabold uppercase tracking-wider">Special $5 Deal</div>
          <div class="text-xs font-mono uppercase tracking-wider text-gray-500 mb-2">Starter Evaluation</div>
