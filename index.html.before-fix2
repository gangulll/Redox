            <div class="text-lg font-extrabold text-white">MetaTrader 5 (MT5)</div>
            <span class="text-xs px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 font-bold">Coming Soon</span>
          </div>
          <p class="text-sm text-gray-400 leading-relaxed">Integration currently undergoing liquidity stress-testing. MT5 accounts will be unlockable directly from your dashboard.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PAYOUTS -->
  <section id="payouts" class="py-20 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-emerald-400 mb-3">Trader Payouts</div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">90% Profit Split via Instant Crypto</h2>
