  <!-- PLATFORMS -->
  <section id="platforms" class="py-20 border-t border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <div class="text-xs font-mono uppercase tracking-[0.3em] text-emerald-400 mb-3">Ultra Low-Latency Infrastructure</div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">Direct Liquidity on cTrader &amp; MT5</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">Say goodbye to slippage and delayed fills. Redox Funded Squad bridges directly with Tier-1 institutional liquidity providers through high-frequency FIX API connectivity.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="card-glass p-6 rounded-3xl border border-emerald-500/30">
          <div class="flex items-center justify-between mb-4">
            <div class="text-lg font-extrabold text-white">cTrader</div>
            <span class="text-xs px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 font-bold">Available Now</span>
          </div>
