  <!-- LOGIN MODAL -->
  <div id="login-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="card-glass max-w-md w-full p-6 sm:p-8 rounded-3xl border border-white/10 relative shadow-2xl">
      <button onclick="closeModal('login-modal')" class="absolute top-6 right-6 text-gray-400 hover:text-white">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>
      <h3 class="text-xl font-extrabold text-white mb-1">Trader Portal Login</h3>
      <p class="text-xs text-gray-400 mb-6">Enter your registered email to access your evaluations</p>

      <form onsubmit="handleLogin(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Trader Email</label>
          <input type="email" required placeholder="name@domain.com" class="w-full bg-black/50 border border-white/10 text-sm text-white px-4 py-3 rounded-xl focus:border-emerald-500 focus:outline-none">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Password</label>
          <input type="password" required placeholder="••••••••" class="w-full bg-black/50 border border-white/10 text-sm text-white px-4 py-3 rounded-xl focus:border-emerald-500 focus:outline-none">
        </div>
        <button type="submit" class="w-full py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs uppercase tracking-wider transition">
          Sign In to Dashboard
        </button>
      </form>
    </div>
  </div>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Modal Handlers
    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    // Checkout Modal Setup
    let currentPlan = '$5,000';
    let currentPrice = 5;

    function startCheckout(plan, price) {
      currentPlan = plan;
      currentPrice = price;
      document.getElementById('checkout-account-label').innerText = 'Purchasing: ' + plan + ' Evaluation Account';
      document.getElementById('checkout-price').innerText = '$' + price.toFixed(2) + ' USDT';
      openModal('checkout-modal');
    }

    // Crypto selection
    const wallets = {
      'USDT_TRC20': 'TLyKxRedoxFundedSquadOfficialTRC20Pay',
      'BTC': 'bc1q9redoxfundedsquadinstitutionalbtc920',
      'ETH': '0x71C8RedoxFundedSquadERC20OfficialVault89'
    };

    function selectCrypto(type) {
      document.querySelectorAll('.crypto-btn').forEach(b => {
        b.classList.remove('border-emerald-500', 'bg-emerald-500/10', 'text-white');
        b.classList.add('border-white/10', 'card-glass', 'text-gray-300');
      });
      event.currentTarget.classList.add('border-emerald-500', 'bg-emerald-500/10', 'text-white');
      event.currentTarget.classList.remove('border-white/10', 'card-glass', 'text-gray-300');

      document.getElementById('deposit-address-input').value = wallets[type];
      document.getElementById('crypto-network-label').innerText = 'Deposit Address (' + type.replace('_', ' ') + ' Network):';
    }

    function copyWallet() {
      const input = document.getElementById('deposit-address-input');
      input.select();
      navigator.clipboard.writeText(input.value);
      const btnText = document.getElementById('copy-btn-text');
      btnText.innerText = 'Copied!';
      setTimeout(() => { btnText.innerText = 'Copy'; }, 2000);
    }

    function confirmSimulatedPayment() {
      const email = document.getElementById('checkout-email').value;
      if (!email || !email.includes('@')) {
        alert('Please enter a valid email address to receive your cTrader login credentials.');
        return;
      }
      closeModal('checkout-modal');
      alert('Payment detected on blockchain! Your ' + currentPlan + ' cTrader credentials have been sent to ' + email + '. Welcome to Redox Funded Squad!');
      openModal('dashboard-preview-modal');
    }

    function handleLogin(e) {
      e.preventDefault();
      closeModal('login-modal');
      openModal('dashboard-preview-modal');
    }

    function requestSimulatedPayout() {
      alert('Payout Request Submitted: $3,825.00 (90% Trader Profit Split). Dispatched to your verified USDT TRC-20 address within 8 hours.');
    }

    // Toggle FAQ
    function toggleFaq(el) {
      const answer = el.querySelector('div:last-child');
      const icon = el.querySelector('i');
      answer.classList.toggle('hidden');
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    }

    // Switch Model View
    function switchModel(model) {
      ['btn-two-phase', 'btn-one-phase', 'btn-instant'].forEach(id => {
        const b = document.getElementById(id);
        b.className = 'px-5 py-2.5 rounded-xl font-medium text-sm text-gray-300 hover:text-white transition';
      });
      const activeBtn = document.getElementById('btn-' + model);
      activeBtn.className = 'px-5 py-2.5 rounded-xl font-bold text-sm bg-emerald-500 text-black transition';
    }
  </script>
</body>
</html>
