                <span class="text-emerald-400">ASK: 1.08423</span>
                <span>VOL: 25.00 Lots</span>
              </div>
              <div class="flex items-center justify-center text-center">
                <div>
                  <div class="text-3xl font-extrabold text-emerald-400 font-mono">+$2,410.50</div>
                  <div class="text-[11px] text-gray-400 mt-1">Live Floating Equity: $52,410.50 (Phase 1 Target: 12%)</div>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 pt-2">
                <div class="bg-red-500/20 border border-red-500/30 text-red-300 py-2 rounded-lg text-center font-bold text-xs">SELL 1.08422</div>
                <div class="bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 py-2 rounded-lg text-center font-bold text-xs">BUY 1.08423</div>
              </div>
            </div>
          </div>
        </div>
