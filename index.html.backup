        </div>
      </div>

      <!-- CTRADER CREDENTIALS BOX -->
      <div class="card-glass p-5 rounded-2xl border border-white/10 mb-6">
        <h4 class="text-xs font-mono uppercase text-gray-400 mb-3 flex items-center gap-2">
          <i data-lucide="key" class="w-4 h-4 text-emerald-400"></i>
          <span>cTrader Platform Credentials</span>
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs">
          <div class="bg-black/50 p-3 rounded-lg border border-white/5">
            <span class="text-gray-500 block text-[10px]">Server:</span>
            <strong class="text-white">Redox-cTrader-Live01</strong>
          </div>
          <div class="bg-black/50 p-3 rounded-lg border border-white/5">
            <span class="text-gray-500 block text-[10px]">Account ID:</span>
            <strong class="text-emerald-400">884920</strong>
          </div>
          <div class="bg-black/50 p-3 rounded-lg border border-white/5">
            <span class="text-gray-500 block text-[10px]">Trader Password:</span>
            <strong class="text-white">Redox$Funded#2026</strong>
          </div>
