        </div>
        <div class="flex items-center gap-2">
          <input id="deposit-address-input" readonly value="TLyKxRedoxFundedSquadOfficialTRC20Pay" class="bg-black/40 border border-white/10 text-xs font-mono text-white px-3 py-2 rounded-lg flex-grow">
          <button onclick="copyWallet()" class="bg-emerald-500 text-black px-3 py-2 rounded-lg text-xs font-bold hover:bg-emerald-400 transition flex items-center gap-1">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i>
            <span id="copy-btn-text">Copy</span>
          </button>
        </div>
      </div>

      <div class="space-y-3">
        <input type="email" id="checkout-email" placeholder="Enter your trader email for credentials" class="w-full bg-black/40 border border-white/10 text-sm text-white px-4 py-3 rounded-xl focus:border-emerald-500 focus:outline-none">
        
        <button onclick="confirmSimulatedPayment()" class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-black font-black text-sm uppercase tracking-wider shadow-lg shadow-emerald-500/25 transition">
          I Have Sent Payment &bull; Activate Account
        </button>
      </div>
      <p class="text-[10px] text-gray-500 text-center mt-3">
        Accounts activate after 1 blockchain confirmation. Simulated testing mode is active.
