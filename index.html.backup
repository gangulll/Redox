      <!-- ACTION BAR -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <button onclick="requestSimulatedPayout()" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs uppercase tracking-wider transition">
          Request Payout (90% Split)
        </button>
        <button onclick="closeModal('dashboard-preview-modal')" class="w-full sm:w-auto px-6 py-3 rounded-xl card-glass text-gray-300 hover:text-white font-semibold text-xs transition">
