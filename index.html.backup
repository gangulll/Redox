            <button id="btn-instant" onclick="switchModel('instant')" class="px-5 py-2.5 rounded-xl font-medium text-sm text-gray-300 hover:text-white transition flex items-center gap-1.5">
              <span>Instant Funded</span>
              <span class="text-[10px] bg-indigo-500/30 text-indigo-300 px-1.5 py-0.5 rounded">No Eval</span>
            </button>
          </div>
        </div>

        <!-- PRICING CARDS -->
        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">

          <!-- $5K STARTER PROMO -->
          <div class="card-glass p-6 rounded-2xl border-2 border-emerald-500 card-glow flex flex-col justify-between relative">
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-emerald-500 text-black text-[10px] font-black uppercase tracking-wider px-3 py-0.5 rounded-full shadow">
              Special $5 Deal
            </div>
            <div>
              <div class="text-gray-400 text-xs font-mono uppercase">Starter Evaluation</div>
