    <!-- PAYOUTS & KYC SECTION -->
    <section id="payouts" class="py-20 bg-[#090d16] border-t border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold mb-2">Trader Payouts</h2>
          <h3 class="text-3xl sm:text-5xl font-extrabold text-white">90% Profit Split via Instant Crypto</h3>
