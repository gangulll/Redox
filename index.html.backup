  <!-- INTERACTIVE DASHBOARD PREVIEW MODAL -->
  <div id="dashboard-preview-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="card-glass max-w-4xl w-full p-6 sm:p-8 rounded-3xl border border-white/10 relative shadow-2xl max-h-[90vh] overflow-y-auto custom-scrollbar">
      <button onclick="closeModal('dashboard-preview-modal')" class="absolute top-6 right-6 text-gray-400 hover:text-white">
        <i data-lucide="x" class="w-6 h-6"></i>
      </button>

      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
            <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="text-xl font-black text-white">Trader Portfolio Terminal</h3>
            <p class="text-xs text-gray-400">Account #RDS-884920 &bull; $50,000 Phase 1</p>
          </div>
        </div>
        <span class="px-3 py-1 bg-emerald-500/10 text-emerald-400 font-mono text-xs rounded-full border border-emerald-500/30">
          Account Status: PASSING
        </span>
      </div>

      <!-- METRICS GRID -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-black/40 p-4 rounded-xl border border-white/5">
          <div class="text-xs text-gray-400">Current Balance</div>
          <div class="text-xl font-bold text-white font-mono mt-1">$54,250.00</div>
          <div class="text-[11px] text-emerald-400 mt-1 font-semibold">+$4,250.00 (+8.5%)</div>
        </div>
        <div class="bg-black/40 p-4 rounded-xl border border-white/5">
          <div class="text-xs text-gray-400">Target (12%)</div>
          <div class="text-xl font-bold text-white font-mono mt-1">$56,000.00</div>
          <div class="text-[11px] text-gray-400 mt-1">$1,750.00 remaining</div>
        </div>
        <div class="bg-black/40 p-4 rounded-xl border border-white/5">
          <div class="text-xs text-gray-400">Daily Drawdown</div>
