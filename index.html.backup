<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Redox Funded Squad | Next-Gen Prop Trading Firm</title>
  <meta name="description" content="Trade up to $200,000 with up to 90% profit split. $5K evaluation challenge for just $5. Fast crypto payouts and ultra-low latency cTrader & MT5 integration.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#ecfdf5',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              accent: '#6366f1',
              gold: '#f59e0b',
              dark: '#0a0d14',
              card: '#111726',
              border: '#1f293d',
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      background-color: #080b11;
      color: #e2e8f0;
      overflow-x: hidden;
    }
    .gradient-glow {
      background: radial-gradient(circle at 50% 20%, rgba(16, 185, 129, 0.15) 0%, rgba(99, 102, 241, 0.08) 45%, transparent 70%);
    }
    .card-glass {
      background: rgba(17, 23, 38, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.07);
    }
    .card-glow:hover {
      border-color: rgba(16, 185, 129, 0.4);
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.15);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #1f293d;
      border-radius: 4px;
    }
  </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col custom-scrollbar">

  <!-- TOP PROMO BANNER -->
  <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-600 text-white text-xs sm:text-sm font-semibold py-2 px-4 text-center flex items-center justify-center gap-2">
    <span class="bg-black/30 px-2 py-0.5 rounded text-[11px] uppercase tracking-wider">Flash Promo</span>
    <span>Start your prop career: <strong>$5,000 Account Challenge for only $5</strong>! Instant cTrader credentials.</span>
    <a href="#challenges" class="underline ml-2 hover:text-emerald-200">Claim Now &rarr;</a>
  </div>

  <!-- NAVIGATION -->
  <header class="sticky top-0 z-40 card-glass border-b border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <!-- LOGO -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-indigo-500 flex items-center justify-center shadow-lg shadow-emerald-500/20 group-hover:scale-105 transition">
          <i data-lucide="trending-up" class="w-6 h-6 text-black stroke-[2.5]"></i>
        </div>
        <div>
          <div class="text-xl font-extrabold tracking-tight text-white flex items-center gap-1.5">
            REDOX <span class="text-emerald-400 font-semibold text-base">FUNDED SQUAD</span>
          </div>
          <p class="text-[10px] text-gray-400 font-mono tracking-widest uppercase">Institutional Prop Firm</p>
        </div>
      </a>

      <!-- NAV LINKS -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-300">
        <a href="#challenges" class="hover:text-emerald-400 transition">Challenges</a>
        <a href="#models" class="hover:text-emerald-400 transition">Models</a>
        <a href="#rules" class="hover:text-emerald-400 transition">Rules & Targets</a>
        <a href="#platforms" class="hover:text-emerald-400 transition">Platforms</a>
        <a href="#payouts" class="hover:text-emerald-400 transition">Payouts & KYC</a>
        <a href="#faq" class="hover:text-emerald-400 transition">FAQ</a>
      </nav>

      <!-- ACTION BUTTONS -->
      <div class="flex items-center gap-3">
        <button onclick="openModal('login-modal')" class="hidden sm:inline-flex text-sm font-semibold text-gray-300 hover:text-white px-4 py-2 rounded-lg transition">
          Trader Login
        </button>
        <a href="#challenges" class="bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-black font-bold text-sm px-5 py-2.5 rounded-xl shadow-lg shadow-emerald-500/25 transition transform hover:-translate-y-0.5">
          Get Funded
        </a>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <main class="flex-grow">
    <section class="relative gradient-glow pt-16 pb-24 overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        
        <!-- BADGE -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full card-glass text-xs font-medium text-emerald-300 mb-6 border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Up to 90% Profit Split &bull; Bi-Weekly Fast Crypto Payouts</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.1] mb-6">
          Trade Institutional Capital.<br>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-indigo-400">
            Keep 90% of the Profits.
          </span>
        </h1>

        <p class="max-w-2xl mx-auto text-base sm:text-lg text-gray-400 mb-10 leading-relaxed">
          Prove your edge with our transparent evaluation challenges. 12% & 8% profit targets, 3 minimum trading days, zero hidden rules, and instant account provisioning on cTrader.
        </p>

        <!-- CTA BUTTONS -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <a href="#challenges" class="w-full sm:w-auto bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-base px-8 py-4 rounded-xl shadow-xl shadow-emerald-500/30 transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
            <span>Explore Challenges</span>
            <i data-lucide="arrow-right" class="w-5 h-5"></i>
          </a>
          <button onclick="openModal('dashboard-preview-modal')" class="w-full sm:w-auto card-glass hover:bg-white/10 text-white font-semibold text-base px-8 py-4 rounded-xl transition flex items-center justify-center gap-2">
            <i data-lucide="layout-dashboard" class="w-5 h-5 text-indigo-400"></i>
            <span>Interactive Trader Portal</span>
          </button>
        </div>

        <!-- STATS BAR -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
          <div class="card-glass p-5 rounded-2xl border border-white/5">
            <div class="text-3xl font-extrabold text-white font-mono">$5,000,000+</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Funded Capital</div>
          </div>
          <div class="card-glass p-5 rounded-2xl border border-white/5">
            <div class="text-3xl font-extrabold text-emerald-400 font-mono">90%</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Trader Profit Split</div>
          </div>
          <div class="card-glass p-5 rounded-2xl border border-white/5">
            <div class="text-3xl font-extrabold text-white font-mono">&lt; 8 Hours</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Payout Processing</div>
          </div>
          <div class="card-glass p-5 rounded-2xl border border-white/5">
            <div class="text-3xl font-extrabold text-indigo-400 font-mono">3 Days</div>
            <div class="text-xs text-gray-400 uppercase tracking-wider mt-1">Min. Trading Days</div>
          </div>
        </div>

      </div>
    </section>

    <!-- CHALLENGES PRICING MATRIX -->
    <section id="challenges" class="py-20 bg-[#090d16] border-t border-b border-white/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-semibold mb-2">Evaluation Accounts</h2>
