                <li class="flex items-center justify-between"><span>Profit Split</span><strong class="text-emerald-400">90%</strong></li>
              </ul>
            </div>
            <button onclick="startCheckout('$5,000', 5)" class="mt-8 w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-xs uppercase tracking-wider shadow-lg shadow-emerald-500/20 transition">
              Start for $5
            </button>
          </div>

          <!-- $10K ACCOUNT -->
          <div class="card-glass p-6 rounded-2xl border border-white/10 card-glow flex flex-col justify-between">
