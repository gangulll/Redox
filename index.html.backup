    <!-- TRADING PLATFORMS -->
    <section id="platforms" class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 text-xs font-mono uppercase mb-4">
              Ultra Low-Latency Infrastructure
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              Direct Liquidity on cTrader & MT5
            </h2>
            <p class="text-gray-400 mt-4 leading-relaxed text-sm sm:text-base">
              Say goodbye to slippage and delayed fills. Redox Funded Squad bridges directly with Tier-1 institutional liquidity providers through high-frequency FIX API connectivity.
            </p>

            <div class="mt-8 space-y-4">
              <div class="card-glass p-4 rounded-xl flex items-start gap-4">
                <div class="p-2.5 rounded-lg bg-emerald-500/10 text-emerald-400 mt-0.5">
                  <i data-lucide="zap" class="w-5 h-5"></i>
                </div>
                <div>
                  <h4 class="font-bold text-white text-sm">cTrader (Available Now)</h4>
